FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

RUN dotnet tool install -g upgrade-assistant
ENV PATH=$PATH:/root/.dotnet/tools

ENV DOTNET_UPGRADEASSISTANT_TELEMETRY_OPTOUT=1

WORKDIR /src

COPY Framework/Net/WebChemistry.Framework.Core/ ./Framework/Net/WebChemistry.Framework.Core/
COPY Plaftorm/WebChemistry.Platform/ ./Plaftorm/WebChemistry.Platform/
COPY AppsAndServices/Tunnels/WebChemistry.Tunnels.Core/ ./AppsAndServices/Tunnels/WebChemistry.Tunnels.Core/
COPY AppsAndServices/Queries/WebChemistry.Queries.Core/ ./AppsAndServices/Queries/WebChemistry.Queries.Core/
COPY AppsAndServices/MotiveValidator/WebChemistry.MotiveValidator.DataModel/ ./AppsAndServices/MotiveValidator/WebChemistry.MotiveValidator.DataModel/
COPY AppsAndServices/MotiveValidator/Database/WebChemistry.MotiveValidator.Database/ ./AppsAndServices/MotiveValidator/Database/WebChemistry.MotiveValidator.Database/
COPY AppsAndServices/Queries/Service/WebChemistry.Queries.Service.DataModel/ ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service.DataModel/
COPY AppsAndServices/Queries/Service/WebChemistry.Queries.Service/ ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service/

RUN cmd='upgrade-assistant upgrade --non-interactive -f net10.0 -o Inplace' \
&& $cmd ./Framework/Net/WebChemistry.Framework.Core/WebChemistry.Framework.Core.csproj \
&& $cmd ./Plaftorm/WebChemistry.Platform/WebChemistry.Platform.csproj \
&& $cmd ./AppsAndServices/Tunnels/WebChemistry.Tunnels.Core/WebChemistry.Tunnels.Core.csproj \
&& $cmd ./AppsAndServices/Queries/WebChemistry.Queries.Core/WebChemistry.Queries.Core.csproj \
&& $cmd ./AppsAndServices/MotiveValidator/WebChemistry.MotiveValidator.DataModel/WebChemistry.MotiveValidator.DataModel.csproj \
&& $cmd ./AppsAndServices/MotiveValidator/Database/WebChemistry.MotiveValidator.Database/WebChemistry.MotiveValidator.Database.csproj \
&& $cmd ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service.DataModel/WebChemistry.Queries.Service.DataModel.csproj \
&& $cmd ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service/WebChemistry.Queries.Service.csproj

RUN dotnet publish AppsAndServices/Queries/Service/WebChemistry.Queries.Service/WebChemistry.Queries.Service.csproj \
    -c Release \
    -o /app/publish \
    /p:GenerateAssemblyInfo=false


FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

RUN chown -R app:app /app

USER app

ENTRYPOINT ["/app/WebChemistry.Queries.Service"]
