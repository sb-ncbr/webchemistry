FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY Framework/Net/WebChemistry.Framework.Core/ ./Framework/Net/WebChemistry.Framework.Core/
COPY AppsAndServices/Tunnels/WebChemistry.Tunnels.Core/ ./AppsAndServices/Tunnels/WebChemistry.Tunnels.Core/
COPY AppsAndServices/Queries/WebChemistry.Queries.Core/ ./AppsAndServices/Queries/WebChemistry.Queries.Core/
COPY AppsAndServices/Queries/Service/WebChemistry.Queries.Service.DataModel/ ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service.DataModel/
COPY AppsAndServices/Queries/Service/WebChemistry.Queries.Service/ ./AppsAndServices/Queries/Service/WebChemistry.Queries.Service/

RUN dotnet publish AppsAndServices/Queries/Service/WebChemistry.Queries.Service/WebChemistry.Queries.Service.csproj \
    -c Release \
    -o /app/publish \
    /p:GenerateAssemblyInfo=false


FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

RUN chown -R app:app /app

USER app

ENTRYPOINT ["/app/WebChemistry.Queries.Service"]
